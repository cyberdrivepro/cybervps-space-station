{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Machine-ID, X-Enrollment-Token, X-CVPS-Pairing-Key, X-Session-Token, X-Admin-Token, X-Pairing-Key, X-Simulate-Public" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://cybervps-space-station.up.railway.app/health"
    },
    {
      "source": "/healthz",
      "destination": "https://cybervps-space-station.up.railway.app/healthz"
    },
    {
      "source": "/api/:path*",
      "destination": "https://cybervps-space-station.up.railway.app/api/:path*"
    },
    {
      "source": "/tunnel/:path*",
      "destination": "https://cybervps-space-station.up.railway.app/tunnel/:path*"
    },
    {
      "source": "/install.:ext*",
      "destination": "https://cybervps-space-station.up.railway.app/install.:ext*"
    },
    {
      "source": "/agent/:path*",
      "destination": "https://cybervps-space-station.up.railway.app/agent/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|tunnel/|agent/|install\\.).*)",
      "destination": "/index.html"
    }
  ]
}
