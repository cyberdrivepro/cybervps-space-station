#!/bin/sh
":" //; DIR="$(cd "$(dirname "$0")" && pwd)"; if command -v node >/dev/null 2>&1; then exec node "$0" "$@"; elif command -v python3 >/dev/null 2>&1; then exec python3 "$DIR/cybervps.py" "$@"; elif command -v python >/dev/null 2>&1; then exec python "$DIR/cybervps.py" "$@"; else echo "Node.js or Python 3 is required." >&2; exit 1; fi
/**
 * CyberVPS SPACE STATION - Official Cross-Platform CLI
 * Unified Host Agent & Network Control CLI
 * Commands: start, stop, restart, status, doctor, logs, config, update, uninstall, version, server
 */

const { spawn, execSync } = require('child_process');
const fs = require('fs');
const path = require('path');
const os = require('os');
const http = require('http');
const https = require('https');

const VERSION = '1.0.0';
let APP_DIR = path.resolve(__dirname, '..');
if (!fs.existsSync(path.join(APP_DIR, 'services', 'server.js'))) {
  const candidate = path.join(APP_DIR, 'space-station');
  if (fs.existsSync(path.join(candidate, 'services', 'server.js'))) {
    APP_DIR = candidate;
  }
}

const BASE_DIR = path.join(os.homedir(), '.cybervps');
const PROGRAMDATA_DIR = process.platform === 'win32'
  ? path.join(process.env.ProgramData || 'C:\\ProgramData', 'CyberVPS')
  : '/var/lib/cybervps';

const hasProgramDataPid = fs.existsSync(path.join(PROGRAMDATA_DIR, 'run', 'agent.pid'));
const ACTIVE_DIR = (hasProgramDataPid || (!fs.existsSync(path.join(BASE_DIR, 'config.json')) && fs.existsSync(path.join(PROGRAMDATA_DIR, 'config.json'))))
  ? PROGRAMDATA_DIR
  : BASE_DIR;

const RUN_DIR = path.join(ACTIVE_DIR, 'run');
const LOG_DIR = path.join(ACTIVE_DIR, 'logs');
const CONFIG_FILE = path.join(ACTIVE_DIR, 'config.json');
const PID_FILE = path.join(RUN_DIR, 'space-station.pid');
const LOG_FILE = path.join(LOG_DIR, 'space-station.log');
const AGENT_PID_FILE = path.join(RUN_DIR, 'agent.pid');
const AGENT_LOG_FILE = path.join(LOG_DIR, 'agent.log');

// Ensure system directories exist
if (!fs.existsSync(RUN_DIR)) {
  try { fs.mkdirSync(RUN_DIR, { recursive: true }); } catch (_) {}
}
if (!fs.existsSync(LOG_DIR)) {
  try { fs.mkdirSync(LOG_DIR, { recursive: true }); } catch (_) {}
}

function isAdmin() {
  if (process.platform === 'win32') {
    try {
      execSync('net session', { stdio: 'ignore' });
      return true;
    } catch (_) {
      try {
        execSync('fltmc', { stdio: 'ignore' });
        return true;
      } catch (_) {
        return false;
      }
    }
  } else {
    return typeof process.getuid === 'function' ? process.getuid() === 0 : false;
  }
}

function assertIsAdmin(action) {
  if (isAdmin()) return true;

  const cfg = loadConfig();
  const token = cfg.token || '';
  const envToken = process.env.CYBERVPS_ADMIN_TOKEN || '';
  if (envToken && envToken === token) return true;

  const faIdx = args.indexOf('--force-auth');
  if (faIdx !== -1 && args[faIdx + 1] && args[faIdx + 1] === token) {
    return true;
  }

  console.log('================================================================');
  console.log('  [!] [ACCESS DENIED] Privileged Operation Prohibited           ');
  console.log('================================================================');
  console.log(`  The '${action}' command requires elevated Administrator privileges.`);
  console.log('');
  console.log('  Standard or shared users cannot stop, restart, or reconfigure');
  console.log('  the 24/7 background CyberVPS Host Agent service.');
  console.log('  To perform authorized maintenance:');
  if (process.platform === 'win32') {
    console.log("    * Reopen terminal using 'Run as Administrator'");
  } else {
    console.log("    * Run with 'sudo' (elevated root privileges)");
  }
  console.log('    * Or provide authorized admin token: --force-auth [TOKEN]');
  console.log('================================================================');
  process.exit(5);
}

function loadConfig() {
  const defaultCfg = {
    server_url: process.env.CYBERVPS_SERVER || 'https://cybervps-space-station.up.railway.app',
    token: process.env.CYBERVPS_TOKEN || 'cvps_enroll_master_token',
    machine_id: '',
    hostname: os.hostname()
  };
  const candidates = [CONFIG_FILE, path.join(PROGRAMDATA_DIR, 'config.json'), path.join(BASE_DIR, 'config.json')];
  for (const c of candidates) {
    if (fs.existsSync(c)) {
      try {
        const parsed = JSON.parse(fs.readFileSync(c, 'utf8'));
        return { ...defaultCfg, ...parsed };
      } catch (_) {}
    }
  }
  return defaultCfg;
}

function saveConfig(data) {
  try {
    const existing = loadConfig();
    const updated = { ...existing, ...data };
    fs.writeFileSync(CONFIG_FILE, JSON.stringify(updated, null, 2), 'utf8');
    return updated;
  } catch (e) {
    console.error(`Failed to save config: ${e.message}`);
    return null;
  }
}

function isPidRunning(pid) {
  if (!pid || isNaN(pid)) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (e) {
    if (e && e.code === 'EPERM') return true;
    if (process.platform === 'win32') {
      try {
        const out = execSync(`tasklist /FI "PID eq ${pid}" /NH`, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
        return out && out.includes(String(pid));
      } catch (_) {}
    }
    return false;
  }
}

function fetchJson(urlStr, timeoutMs = 3500) {
  return new Promise((resolve) => {
    try {
      const proxy = process.env.https_proxy || process.env.HTTPS_PROXY || process.env.http_proxy || process.env.HTTP_PROXY;
      if (proxy) {
        try {
          const cp = require('child_process');
          const out = cp.execSync(`curl -sSL --max-time 4 "${urlStr}"`, { encoding: 'utf8', stdio: ['pipe', 'pipe', 'ignore'] });
          try {
            resolve({ statusCode: 200, data: JSON.parse(out) });
            return;
          } catch (_) {
            resolve({ statusCode: 200, data: null });
            return;
          }
        } catch (_) {
          resolve(null);
          return;
        }
      }
      const parsed = new URL(urlStr);
      const client = parsed.protocol === 'https:' ? https : http;
      const req = client.get(urlStr, { timeout: timeoutMs }, (res) => {
        let data = '';
        res.on('data', c => data += c);
        res.on('end', () => {
          try {
            resolve({ statusCode: res.statusCode, data: JSON.parse(data) });
          } catch (_) {
            resolve({ statusCode: res.statusCode, data: null });
          }
        });
      });
      req.on('timeout', () => { req.destroy(); resolve(null); });
      req.on('error', () => resolve(null));
    } catch (_) {
      resolve(null);
    }
  });
}

const args = process.argv.slice(2);
const command = args[0] || 'help';

async function main() {
  switch (command.toLowerCase()) {
    case 'start':
    case 'agent':
      await handleStart(false);
      break;
    case 'ghost':
      await handleStart(true);
      break;
    case 'stop':
      await handleStop();
      break;
    case 'restart':
      await handleStop();
      await new Promise(r => setTimeout(r, 1000));
      await handleStart();
      break;
    case 'status':
      await handleStatus();
      break;
    case 'doctor':
      await handleDoctor();
      break;
    case 'logs':
      handleLogs();
      break;
    case 'config':
      handleConfig();
      break;
    case 'server':
      await handleServerCommand();
      break;
    case 'install':
      handleInstall();
      break;
    case 'update':
      handleUpdate();
      break;
    case 'uninstall':
      handleUninstall();
      break;
    case 'bridge':
    case 'tunnel':
      await handleBridge();
      break;
    case 'desktop':
    case 'rdp':
      await handleBridge(3389);
      break;
    case 'desktop-launch':
    case 'gui-launch':
      await handleDesktopLaunch();
      break;
    case 'vnc':
      await handleBridge(5900);
      break;
    case 'sftp':
      await handleBridge(22);
      break;
    case 'ssh':
      await handleBridge(22);
      break;
    case 'version':
    case '-v':
    case '--version':
      console.log(`CyberVPS Space Station v${VERSION} (${process.platform}-${os.arch()})`);
      break;
    case 'help':
    case '--help':
    default:
      showHelp();
      break;
  }
}

function showHelp() {
  console.log(`
🛰️  CYBERVPS SPACE STATION CLI v${VERSION}
================================================================
Usage: cybervps <command> [options]

Commands:
  start           Start CyberVPS Host Agent in background (24/7 connection)
  stop            Stop running background Host Agent
  restart         Restart background Host Agent
  status          Show agent health, fleet enrollment, and central dashboard
  bridge          Bridge remote port to local PC (e.g. cybervps bridge SoloA 22)
  desktop, rdp    Direct Windows Remote Desktop (RDP :3389) bridge shortcut
  desktop-launch  Launch GUI application on active desktop (e.g. cybervps desktop-launch notepad)
  vnc             Direct VNC (:5900) bridge shortcut to remote machine
  sftp            Direct SFTP bridge shortcut to remote machine
  ssh             Direct SSH bridge shortcut to remote machine
  doctor          Run system diagnostics, runtime checks, and egress reachability
  logs            View real-time agent execution and streaming logs
  config          View or update backend target URL and tokens
  server          Manage central control plane (server start, server stop)
  update          Update CyberVPS Space Station from GitHub repository
  uninstall       Remove background service/task, logs, and CLI shortcuts
  version         Display CLI version and platform runtime

Examples:
  cybervps status               Inspect agent health and central connection
  cybervps bridge SoloA 22 2222 Forward remote port 22 to local 127.0.0.1:2222
  cybervps sftp SoloA           Start SFTP bridge to SoloA
  cybervps logs                 Display recent output from background agent
  cybervps config set server    Change central backend URL
================================================================
`);
}

function findPythonRuntime() {
  if (process.platform === 'win32') {
    try {
      const raw = execSync('where.exe python', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
      const paths = raw.split(/\r?\n/)
        .map(p => p.trim())
        .filter(p => p && !p.toLowerCase().includes('windowsapps') && fs.existsSync(p));
      for (const p of paths) {
        try {
          const ver = execSync(`"${p}" --version`, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
          if (ver.includes('Python 3')) return { cmd: p, argsPrefix: [], version: ver.trim() };
        } catch (_) {}
      }
    } catch (_) {}

    try {
      const pyVer = execSync('py -3 --version', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
      if (pyVer.includes('Python 3')) {
        return { cmd: 'py', argsPrefix: ['-3'], version: pyVer.trim() };
      }
    } catch (_) {}

    return null;
  } else {
    for (const bin of ['python3', 'python']) {
      try {
        const ver = execSync(`${bin} --version`, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
        if (ver.includes('Python 3') || ver.includes('Python')) {
          return { cmd: bin, argsPrefix: [], version: ver.trim() };
        }
      } catch (_) {}
    }
    return null;
  }
}

async function handleStart(isGhost = false) {
  const config = loadConfig();
  let serverUrl = config.server_url;
  let token = config.token;

  for (let i = 1; i < args.length; i++) {
    if ((args[i] === '--server' || args[i] === '-s') && args[i + 1]) {
      serverUrl = args[i + 1];
      i++;
    } else if ((args[i] === '--token' || args[i] === '-t') && args[i + 1]) {
      token = args[i + 1];
      i++;
    } else if (args[i] === '--ghost') {
      isGhost = true;
    } else if (args[i].startsWith('http://') || args[i].startsWith('https://')) {
      serverUrl = args[i];
    }
  }

  // Check if agent is already running
  if (fs.existsSync(AGENT_PID_FILE)) {
    const existingPid = parseInt(fs.readFileSync(AGENT_PID_FILE, 'utf8').trim(), 10);
    if (isPidRunning(existingPid)) {
      console.log(`⚠️  CyberVPS Agent is already running in background (PID: ${existingPid}).`);
      console.log(`   Connected to: ${serverUrl}`);
      console.log(`   Run 'cybervps status' to inspect, or 'cybervps stop' to terminate.`);
      return;
    } else {
      fs.unlinkSync(AGENT_PID_FILE);
    }
  }

  if (!/^https?:\/\//i.test(serverUrl)) {
    serverUrl = 'https://' + serverUrl;
  }

  console.log(`[*] Launching CyberVPS Host Agent ${isGhost ? '(Ghost Mode) ' : ''}connecting to ${serverUrl}...`);

  const agentScript = path.join(APP_DIR, 'agent', 'universal-agent.py');
  const ghostBridgePs1 = path.join(APP_DIR, 'agent', 'ghost-bridge.ps1');
  const ghostBridgeSh = path.join(APP_DIR, 'agent', 'ghost-bridge.sh');

  const pyRuntime = findPythonRuntime();
  if (!pyRuntime) {
    if (process.platform === 'win32' && fs.existsSync(ghostBridgePs1)) {
      console.log('⚡ Zero-dependency fallback: Activating Windows Native PowerShell Ghost Bridge...');
      const child = spawn('powershell.exe', [
        '-WindowStyle', 'Hidden',
        '-NoProfile',
        '-ExecutionPolicy', 'Bypass',
        '-File', ghostBridgePs1,
        '-Server', serverUrl,
        '-Token', token
      ], {
        detached: true,
        stdio: 'ignore',
        windowsHide: true
      });
      child.unref();
      fs.writeFileSync(path.join(RUN_DIR, 'ghost-bridge.pid'), String(child.pid), 'utf8');
      console.log(`✅ CyberVPS Ghost Bridge active in background (PID: ${child.pid}).`);
      console.log(`   Connected to: ${serverUrl}`);
      console.log(`   Ghost Mode: Active (Zero external dependencies)`);
      return;
    } else if (process.platform !== 'win32' && fs.existsSync(ghostBridgeSh)) {
      console.log('⚡ Zero-dependency fallback: Activating Linux Zero-Dependency Ghost Bridge...');
      const child = spawn('sh', [ghostBridgeSh, serverUrl, token], {
        detached: true,
        stdio: 'ignore'
      });
      child.unref();
      fs.writeFileSync(path.join(RUN_DIR, 'ghost-bridge.pid'), String(child.pid), 'utf8');
      console.log(`✅ CyberVPS Ghost Bridge active in background (PID: ${child.pid}).`);
      console.log(`   Connected to: ${serverUrl}`);
      console.log(`   Ghost Mode: Active (Zero external dependencies)`);
      return;
    }

    console.error('❌ Error: Python 3 runtime is required to run the CyberVPS Host Agent.');
    console.error("👉 Please install Python 3 and ensure 'Add Python to PATH' is checked: https://www.python.org/downloads/");
    process.exit(1);
  }

  if (!fs.existsSync(agentScript)) {
    console.error(`❌ Agent script not found at ${agentScript}`);
    process.exit(1);
  }

  let execBinary = pyRuntime.cmd;

  const agentEnv = {
    ...process.env,
    PYTHONUNBUFFERED: '1',
    CYBERVPS_SERVER: serverUrl,
    CYBERVPS_TOKEN: token,
    CYBERVPS_CONFIG: CONFIG_FILE,
    CYBERVPS_LOG_FILE: AGENT_LOG_FILE
  };
  if (isGhost) {
    agentEnv.CYBERVPS_GHOST_MODE = '1';
  }

  const pyArgs = [...pyRuntime.argsPrefix, '-u', agentScript, '--server', serverUrl, '--token', token, '--config', CONFIG_FILE];
  if (isGhost) {
    pyArgs.push('--ghost');
  }

  const child = spawn(execBinary, pyArgs, {
    detached: true,
    stdio: 'ignore',
    windowsHide: true,
    env: agentEnv
  });
  child.unref();
  const childPid = child.pid;

  fs.writeFileSync(AGENT_PID_FILE, String(childPid), 'utf8');

  console.log(`✅ CyberVPS Host Agent active in background (PID: ${childPid})${isGhost ? ' [Ghost Mode]' : ''}.`);
  console.log(`   Target Backend: ${serverUrl}`);
  console.log(`   Log output:     ${AGENT_LOG_FILE}`);

  // Quick verify
  await new Promise(r => setTimeout(r, 1200));
  await handleStatus();
}

async function handleStop() {
  assertIsAdmin('stop');
  let anyStopped = false;

  if (fs.existsSync(AGENT_PID_FILE)) {
    const pid = parseInt(fs.readFileSync(AGENT_PID_FILE, 'utf8').trim(), 10);
    if (isPidRunning(pid)) {
      console.log(`[*] Stopping CyberVPS Agent (PID: ${pid})...`);
      try { process.kill(pid, 'SIGTERM'); anyStopped = true; } catch (_) {}
    }
    fs.unlinkSync(AGENT_PID_FILE);
  }

  // On Windows, also check scheduled task
  if (process.platform === 'win32') {
    try {
      execSync('schtasks /End /TN "CyberVPS-Space-Station-Agent"', { stdio: 'ignore' });
    } catch (_) {}
  }

  if (fs.existsSync(PID_FILE)) {
    const sPid = parseInt(fs.readFileSync(PID_FILE, 'utf8').trim(), 10);
    if (isPidRunning(sPid)) {
      console.log(`[*] Stopping Central Control Plane (PID: ${sPid})...`);
      try { process.kill(sPid, 'SIGTERM'); anyStopped = true; } catch (_) {}
    }
    fs.unlinkSync(PID_FILE);
  }

  if (anyStopped) {
    console.log('✅ CyberVPS background services stopped successfully.');
  } else {
    console.log('ℹ️  No CyberVPS processes were currently running.');
  }
}

async function handleStatus() {
  console.log('================================================================');
  console.log('🛰️  CYBERVPS SPACE STATION STATUS');
  console.log('================================================================');

  const config = loadConfig();
  const serverUrl = config.server_url;
  const hostname = config.hostname || os.hostname();

  let aPid = null;
  let isAgentRunning = false;
  if (fs.existsSync(AGENT_PID_FILE)) {
    aPid = parseInt(fs.readFileSync(AGENT_PID_FILE, 'utf8').trim(), 10);
    isAgentRunning = isPidRunning(aPid);
  }

  // Check background scheduled task or logon autostart on Windows
  let taskStatus = 'Not Installed';
  if (process.platform === 'win32') {
    try {
      const q = execSync('schtasks /Query /TN "CyberVPS-Space-Station-Agent" /FO CSV /NH', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
      if (q && q.includes('CyberVPS-Space-Station-Agent')) {
        taskStatus = q.toLowerCase().includes('running') ? 'Running (24/7 Auto-Start)' : 'Ready (Auto-Start on Logon)';
      }
    } catch (_) {}
    if (taskStatus === 'Not Installed') {
      try {
        const reg = execSync('reg query "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run" /v CyberVPS-Agent', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
        if (reg && reg.includes('CyberVPS-Agent')) {
          taskStatus = 'Configured (User Registry Autostart)';
        }
      } catch (_) {}
    }
    if (taskStatus === 'Not Installed') {
      const startupLink = path.join(process.env.APPDATA || '', 'Microsoft', 'Windows', 'Start Menu', 'Programs', 'Startup', 'CyberVPS-Agent.lnk');
      if (fs.existsSync(startupLink)) {
        taskStatus = 'Configured (User Startup Shortcut)';
      }
    }
  } else if (fs.existsSync('/etc/systemd/system/cybervps-agent.service')) {
    taskStatus = 'Installed (systemd)';
  }

  console.log(`[Host]        ${hostname} (${process.platform}-${os.arch()})`);
  console.log(`[Agent]       ${isAgentRunning ? `RUNNING (PID: ${aPid}) ✅` : 'STOPPED 🔴'}`);
  if (taskStatus !== 'Not Installed') {
    console.log(`[Autostart]   ${taskStatus} ✅`);
  }

  // Ping Central Backend
  const t0 = Date.now();
  const health = await fetchJson(`${serverUrl}/health`, 4000);
  const latency = health ? `${Date.now() - t0}ms` : 'Unreachable';

  console.log(`[Backend]     ${serverUrl} (${latency})`);

  if (health && health.statusCode === 200) {
    // Check if enrolled in machine fleet
    const mRes = await fetchJson(`${serverUrl}/api/v1/machines`, 4000);
    if (mRes && Array.isArray(mRes.data)) {
      const thisNode = mRes.data.find(m => m.hostname === hostname || m.id === config.machine_id);
      if (thisNode) {
        console.log(`[Fleet Status] ONLINE in Space Station Fleet ✅`);
        console.log(`[Virtual IP]   ${thisNode.virtual_ip || 'Assigned'}`);
        console.log(`[Machine ID]   ${thisNode.id}`);
        console.log(`[Uptime]       ${thisNode.uptime_seconds || 0} seconds`);
      } else {
        console.log(`[Fleet Status] Enrolling... (Agent active; awaiting first heartbeat)`);
      }
    }
  } else {
    console.log(`[Fleet Status] Backend unreachable. Agent will auto-reconnect.`);
  }

  console.log(``);
  console.log(`👉 Official Single Dashboard:`);
  console.log(`   https://cyberdrivepro.github.io/cybervps-space-station/`);
  console.log('================================================================');
}

async function handleServerCommand() {
  const subCmd = args[1] || 'status';
  const port = process.env.PORT || '8080';
  const serverPath = path.join(APP_DIR, 'services', 'server.js');

  if (subCmd === 'start') {
    if (fs.existsSync(PID_FILE)) {
      const pid = parseInt(fs.readFileSync(PID_FILE, 'utf8').trim(), 10);
      if (isPidRunning(pid)) {
        console.log(`⚠️  Control Plane server already running (PID: ${pid}) on port ${port}.`);
        return;
      }
    }
    console.log(`[*] Starting Central Control Plane on port ${port}...`);
    const env = { ...process.env, PORT: port, CYBERVPS_LOG_FILE: LOG_FILE };
    const child = spawn(process.execPath, [serverPath], { cwd: APP_DIR, env, detached: true, stdio: 'ignore' });
    child.unref();
    fs.writeFileSync(PID_FILE, String(child.pid), 'utf8');
    console.log(`✅ Control Plane server active (PID: ${child.pid}) on port ${port}.`);
  } else if (subCmd === 'stop') {
    if (fs.existsSync(PID_FILE)) {
      const pid = parseInt(fs.readFileSync(PID_FILE, 'utf8').trim(), 10);
      if (isPidRunning(pid)) {
        try { process.kill(pid, 'SIGTERM'); } catch (_) {}
        console.log(`✅ Stopped Control Plane server (PID: ${pid}).`);
      }
      fs.unlinkSync(PID_FILE);
    }
  } else {
    console.log(`Usage: cybervps server [start|stop]`);
  }
}

function handleConfig() {
  const action = args[1] || 'get';
  const key = args[2];
  const value = args[3];

  const cfg = loadConfig();

  if (action === 'get') {
    if (key) {
      console.log(cfg[key] !== undefined ? cfg[key] : `Key '${key}' not found.`);
    } else {
      console.log('Current Configuration (~/.cybervps/config.json):');
      console.log(JSON.stringify(cfg, null, 2));
    }
  } else if (action === 'set') {
    if (!key || !value) {
      console.log('Usage: cybervps config set <key> <value>');
      return;
    }
    if (key === 'server' || key === 'server_url') {
      let norm = value.trim().replace(/\/+$/, '');
      if (!/^https?:\/\//i.test(norm)) norm = 'https://' + norm;
      key = 'server_url';
      value = norm;
    }
    cfg[key] = value;
    saveConfig(cfg);
    console.log(`✅ Updated config: ${key} = ${value}`);
  }
}

async function handleDesktopLaunch() {
  const appName = args[1] || 'notepad.exe';
  const cfg = loadConfig();
  const serverUrl = cfg.server_url || 'http://127.0.0.1:8080';
  const machineId = cfg.machine_id;

  console.log(`[*] Requesting interactive desktop launch for '${appName}'...`);
  try {
    const res = await request(`${serverUrl}/api/v1/desktop/launch`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        machine_id: machineId,
        executable: appName
      })
    });
    const data = JSON.parse(res.body || '{}');
    const result = data.result || data;
    if (result.success) {
      console.log(`✅ SUCCESS: Launched '${appName}' on interactive desktop!`);
      if (result.pid) console.log(`   PID: ${result.pid}`);
      if (result.session_id) console.log(`   Session ID: ${result.session_id}`);
    } else {
      console.log(`⚠️ Status: ${result.status || 'FAILED'}`);
      console.log(`   ${result.error || data.error || 'Failed to launch on desktop'}`);
    }
  } catch (err) {
    console.error(`❌ Error connecting to control plane: ${err.message}`);
  }
}

function handleLogs() {
  const logFile = args.includes('--server') ? LOG_FILE : AGENT_LOG_FILE;
  if (!fs.existsSync(logFile)) {
    console.log('ℹ️  No log file found at ' + logFile);
    return;
  }
  const lines = fs.readFileSync(logFile, 'utf8').split('\n').filter(Boolean);
  const tail = lines.slice(-50);
  console.log(`--- [Last ${tail.length} lines of ${logFile}] ---`);
  console.log(tail.join('\n'));
}

async function handleDoctor() {
  console.log('================================================================');
  console.log('🩺 CYBERVPS SYSTEM DOCTOR & ENVIRONMENT DIAGNOSTICS');
  console.log('================================================================');

  console.log(`[OS] Platform: ${process.platform}, Arch: ${os.arch()}, Release: ${os.release()}`);
  console.log(`[OS] CPUs: ${os.cpus().length}, Memory: ${Math.round(os.totalmem() / 1024 / 1024)} MB`);
  console.log(`[Node] Version: ${process.version}, Executable: ${process.execPath}`);

  // Check Python
  const pyRuntime = findPythonRuntime();
  if (pyRuntime) {
    console.log(`[Python]      ${pyRuntime.version || pyRuntime.cmd} ✅`);
  } else {
    console.log(`[Python]      Python 3 NOT detected (Excluding WindowsApps placeholder) ❌`);
  }

  // Outbound Egress Checks
  console.log('[Network] Checking outbound HTTPS reachability...');
  const checkUrl = (u) => new Promise(r => {
    try {
      const parsed = new URL(u);
      const req = https.get({ hostname: parsed.hostname, path: '/', timeout: 4000 }, (res) => r(res.statusCode));
      req.on('error', () => r(null));
      req.on('timeout', () => { req.destroy(); r(null); });
    } catch (_) { r(null); }
  });

  const ghStatus = await checkUrl('https://github.com');
  console.log(`[Egress] GitHub HTTPS:    ${ghStatus ? 'REACHABLE ✅' : 'UNREACHABLE ❌'}`);

  const rwStatus = await checkUrl('https://cybervps-space-station.up.railway.app/health');
  console.log(`[Egress] Railway Backend: ${rwStatus ? 'REACHABLE (200 OK) ✅' : 'UNREACHABLE ❌'}`);

  console.log('\n✅ Diagnostic scan complete.');
  console.log('================================================================');
}

function handleInstall() {
  console.log('================================================================');
  console.log('📦 CYBERVPS SPACE STATION DEPENDENCY INSTALLER');
  console.log('================================================================');
  try {
    const npmCmd = process.platform === 'win32' ? 'npm.cmd' : 'npm';
    execSync(`${npmCmd} install --omit=dev --no-audit --no-fund`, { cwd: APP_DIR, stdio: 'inherit' });
    console.log('\n🎉 Dependencies installed successfully!');
  } catch (e) {
    console.error(`❌ Installation error: ${e.message}`);
  }
}

function handleUpdate() {
  console.log('================================================================');
  console.log('🔄 UPDATING CYBERVPS SPACE STATION FROM GITHUB');
  console.log('================================================================');
  try {
    execSync('git pull origin main', { cwd: APP_DIR, stdio: 'inherit' });
    console.log('\n🎉 CyberVPS Space Station updated to latest version!');
  } catch (e) {
    console.error(`❌ Update failed: ${e.message}`);
  }
}

function handleUninstall() {
  assertIsAdmin('uninstall');
  console.log('================================================================');
  console.log('🗑️  UNINSTALL CYBERVPS SPACE STATION');
  console.log('================================================================');
  handleStop();

  if (process.platform === 'win32') {
    try {
      execSync('schtasks /Delete /TN "CyberVPS-Space-Station-Agent" /F', { stdio: 'ignore' });
      console.log('[*] Removed Windows Scheduled Task.');
    } catch (_) {}
    try {
      execSync('reg delete "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run" /v CyberVPS-Agent /f', { stdio: 'ignore' });
      console.log('[*] Removed User Registry Autostart key.');
    } catch (_) {}
    try {
      const startupLink = path.join(process.env.APPDATA || '', 'Microsoft', 'Windows', 'Start Menu', 'Programs', 'Startup', 'CyberVPS-Agent.lnk');
      if (fs.existsSync(startupLink)) {
        fs.unlinkSync(startupLink);
        console.log('[*] Removed User Startup shortcut.');
      }
    } catch (_) {}
  } else if (fs.existsSync('/etc/systemd/system/cybervps-agent.service')) {
    try {
      execSync('systemctl disable --now cybervps-agent.service; rm -f /etc/systemd/system/cybervps-agent.service; systemctl daemon-reload', { stdio: 'ignore' });
      console.log('[*] Removed systemd service.');
    } catch (_) {}
  }

  console.log('✅ Background agent removed cleanly. You can remove ~/.cybervps if desired.');
}

async function handleBridge(defaultRemotePort = null) {
  const targetMachine = process.argv[3];
  const remotePort = parseInt(process.argv[4] || defaultRemotePort || '22', 10);
  const preferredLocalPort = parseInt(process.argv[5] || (remotePort === 22 ? '2222' : String(remotePort)), 10);

  if (!targetMachine) {
    console.log(`
🛰️  CYBERVPS PORT BRIDGE (MODE A)
================================================================
Usage: cybervps bridge <machine_name_or_id> [remote_port] [local_port]
       cybervps sftp   <machine_name_or_id> [local_port]
       cybervps ssh    <machine_name_or_id> [local_port]

Examples:
  cybervps bridge SoloA 22 2222         # Bridge SoloA SSH/SFTP (port 22) to 127.0.0.1:2222
  cybervps sftp SoloA                   # Bridge SoloA port 22 and show SFTP connect command
  cybervps bridge WIN-IK7N6SD2UBU 80    # Bridge Windows web server port 80 to 127.0.0.1:80
================================================================
    `);
    return;
  }

  const cfg = loadConfig();
  const serverUrl = cfg.server_url || 'https://cybervps-space-station.up.railway.app';

  console.log(`[*] Resolving machine '${targetMachine}' via ${serverUrl}...`);
  let resolvedMachineId = targetMachine;
  let resolvedHostname = targetMachine;
  try {
    const machinesRes = await fetchJson(`${serverUrl}/api/v1/machines`, 5000);
    if (machinesRes && machinesRes.data && Array.isArray(machinesRes.data)) {
      const matched = machinesRes.data.find(m =>
        m.id.toLowerCase() === targetMachine.toLowerCase() ||
        m.hostname.toLowerCase() === targetMachine.toLowerCase() ||
        (m.friendly_name && m.friendly_name.toLowerCase() === targetMachine.toLowerCase()) ||
        m.id.toLowerCase().includes(targetMachine.toLowerCase())
      );
      if (matched) {
        resolvedMachineId = matched.id;
        resolvedHostname = matched.hostname || matched.friendly_name || matched.id;
        console.log(`[+] Fleet match: [${resolvedHostname}] (${resolvedMachineId}) - Status: ${matched.status}`);
      } else {
        console.log(`[!] Notice: '${targetMachine}' not listed in active fleet. Attempting direct ID...`);
      }
    }
  } catch (_) {}

  const bridgePath = path.join(APP_DIR, 'apps', 'windows-client', 'bridge-daemon.js');
  if (!fs.existsSync(bridgePath)) {
    console.error(`[X] Error: Bridge daemon not found at ${bridgePath}`);
    return;
  }

  const { WindowsPortBridgeClient } = require(bridgePath);
  const bridge = new WindowsPortBridgeClient({ serverUrl });
  await bridge.start(false);
  const mapping = await bridge.addMapping('bridge_' + Date.now(), resolvedMachineId, remotePort, preferredLocalPort);

  console.log('\n================================================================');
  console.log(`⚡ PORT BRIDGE ESTABLISHED & RUNNING`);
  console.log(`================================================================`);
  console.log(`Local Endpoint:  127.0.0.1:${mapping.localPort}`);
  console.log(`Remote Target:   [${resolvedHostname}]:${remotePort}`);
  if (remotePort === 22) {
    console.log(`\nConnect with native SFTP client:`);
    console.log(`  sftp -P ${mapping.localPort} user@127.0.0.1`);
    console.log(`\nConnect with native SSH client:`);
    console.log(`  ssh -p ${mapping.localPort} user@127.0.0.1`);
  } else if (remotePort === 3389) {
    console.log(`\nWindows Remote Desktop (RDP):`);
    console.log(`  mstsc /v:127.0.0.1:${mapping.localPort}`);
    if (process.platform === 'win32') {
      console.log(`[*] Automatically launching Windows Remote Desktop client (mstsc.exe)...`);
      try {
        const { spawn } = require('child_process');
        spawn('mstsc.exe', [`/v:127.0.0.1:${mapping.localPort}`], { detached: true, stdio: 'ignore' }).unref();
      } catch (_) {}
    }
  } else if (remotePort === 5900) {
    console.log(`\nConnect with native VNC viewer:`);
    console.log(`  vnc://127.0.0.1:${mapping.localPort}`);
  } else {
    console.log(`\nLocal Web URL:`);
    console.log(`  http://127.0.0.1:${mapping.localPort}`);
  }
  console.log(`================================================================`);
  console.log(`Relay active across Space Station. Press Ctrl+C to disconnect.\n`);

  process.on('SIGINT', () => {
    console.log('\n[*] Disconnecting port bridge...');
    bridge.stop();
    process.exit(0);
  });
}

main().catch(err => {
  console.error('Fatal CLI Error:', err);
  process.exit(1);
});
