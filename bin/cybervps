#!/usr/bin/env node
/**
 * CyberVPS SPACE STATION - Official Cross-Platform CLI
 * Unified Host Agent & Network Control CLI
 * Commands: start, stop, restart, status, doctor, logs, config, update, uninstall, version, server
 */

const { spawn, execSync } = require('child_process');
const fs = require('fs');
const path = require('path');
const os = require('os');
const http = require('http');
const https = require('https');

const VERSION = '1.0.0';
let APP_DIR = path.resolve(__dirname, '..');
if (!fs.existsSync(path.join(APP_DIR, 'services', 'server.js'))) {
  const candidate = path.join(APP_DIR, 'space-station');
  if (fs.existsSync(path.join(candidate, 'services', 'server.js'))) {
    APP_DIR = candidate;
  }
}

const BASE_DIR = path.join(os.homedir(), '.cybervps');
const RUN_DIR = path.join(BASE_DIR, 'run');
const LOG_DIR = path.join(BASE_DIR, 'logs');
const CONFIG_FILE = path.join(BASE_DIR, 'config.json');
const PID_FILE = path.join(RUN_DIR, 'space-station.pid');
const LOG_FILE = path.join(LOG_DIR, 'space-station.log');
const AGENT_PID_FILE = path.join(RUN_DIR, 'agent.pid');
const AGENT_LOG_FILE = path.join(LOG_DIR, 'agent.log');

// Ensure system directories exist
if (!fs.existsSync(RUN_DIR)) fs.mkdirSync(RUN_DIR, { recursive: true });
if (!fs.existsSync(LOG_DIR)) fs.mkdirSync(LOG_DIR, { recursive: true });

function loadConfig() {
  const defaultCfg = {
    server_url: process.env.CYBERVPS_SERVER || 'https://cybervps-space-station.up.railway.app',
    token: process.env.CYBERVPS_TOKEN || 'cvps_enroll_master_token',
    machine_id: '',
    hostname: os.hostname()
  };
  if (fs.existsSync(CONFIG_FILE)) {
    try {
      const parsed = JSON.parse(fs.readFileSync(CONFIG_FILE, 'utf8'));
      return { ...defaultCfg, ...parsed };
    } catch (_) {}
  }
  return defaultCfg;
}

function saveConfig(data) {
  try {
    const existing = loadConfig();
    const updated = { ...existing, ...data };
    fs.writeFileSync(CONFIG_FILE, JSON.stringify(updated, null, 2), 'utf8');
    return updated;
  } catch (e) {
    console.error(`Failed to save config: ${e.message}`);
    return null;
  }
}

function isPidRunning(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (e) {
    return false;
  }
}

function fetchJson(urlStr, timeoutMs = 3500) {
  return new Promise((resolve) => {
    try {
      const parsed = new URL(urlStr);
      const client = parsed.protocol === 'https:' ? https : http;
      const req = client.get(urlStr, { timeout: timeoutMs }, (res) => {
        let data = '';
        res.on('data', c => data += c);
        res.on('end', () => {
          try {
            resolve({ statusCode: res.statusCode, data: JSON.parse(data) });
          } catch (_) {
            resolve({ statusCode: res.statusCode, data: null });
          }
        });
      });
      req.on('timeout', () => { req.destroy(); resolve(null); });
      req.on('error', () => resolve(null));
    } catch (_) {
      resolve(null);
    }
  });
}

const args = process.argv.slice(2);
const command = args[0] || 'help';

async function main() {
  switch (command.toLowerCase()) {
    case 'start':
    case 'agent':
      await handleStart();
      break;
    case 'stop':
      await handleStop();
      break;
    case 'restart':
      await handleStop();
      await new Promise(r => setTimeout(r, 1000));
      await handleStart();
      break;
    case 'status':
      await handleStatus();
      break;
    case 'doctor':
      await handleDoctor();
      break;
    case 'logs':
      handleLogs();
      break;
    case 'config':
      handleConfig();
      break;
    case 'server':
      await handleServerCommand();
      break;
    case 'install':
      handleInstall();
      break;
    case 'update':
      handleUpdate();
      break;
    case 'uninstall':
      handleUninstall();
      break;
    case 'version':
    case '-v':
    case '--version':
      console.log(`CyberVPS Space Station v${VERSION} (${process.platform}-${os.arch()})`);
      break;
    case 'help':
    case '--help':
    default:
      showHelp();
      break;
  }
}

function showHelp() {
  console.log(`
🛰️  CYBERVPS SPACE STATION CLI v${VERSION}
================================================================
Usage: cybervps <command> [options]

Commands:
  start           Start CyberVPS Host Agent in background (24/7 connection)
  stop            Stop running background Host Agent
  restart         Restart background Host Agent
  status          Show agent health, fleet enrollment, and central dashboard
  doctor          Run system diagnostics, runtime checks, and egress reachability
  logs            View real-time agent execution and streaming logs
  config          View or update backend target URL and tokens
  server          Manage central control plane (server start, server stop)
  update          Update CyberVPS Space Station from GitHub repository
  uninstall       Remove background service/task, logs, and CLI shortcuts
  version         Display CLI version and platform runtime

Examples:
  cybervps status               Inspect agent health and central connection
  cybervps start                Start agent in 24/7 background mode
  cybervps logs                 Display recent output from background agent
  cybervps config set server    Change central backend URL
================================================================
`);
}

async function handleStart() {
  const config = loadConfig();
  let serverUrl = config.server_url;
  let token = config.token;

  for (let i = 1; i < args.length; i++) {
    if ((args[i] === '--server' || args[i] === '-s') && args[i + 1]) {
      serverUrl = args[i + 1];
      i++;
    } else if ((args[i] === '--token' || args[i] === '-t') && args[i + 1]) {
      token = args[i + 1];
      i++;
    } else if (args[i].startsWith('http://') || args[i].startsWith('https://')) {
      serverUrl = args[i];
    }
  }

  // Check if agent is already running
  if (fs.existsSync(AGENT_PID_FILE)) {
    const existingPid = parseInt(fs.readFileSync(AGENT_PID_FILE, 'utf8').trim(), 10);
    if (isPidRunning(existingPid)) {
      console.log(`⚠️  CyberVPS Agent is already running in background (PID: ${existingPid}).`);
      console.log(`   Connected to: ${serverUrl}`);
      console.log(`   Run 'cybervps status' to inspect, or 'cybervps stop' to terminate.`);
      return;
    } else {
      fs.unlinkSync(AGENT_PID_FILE);
    }
  }

  console.log(`[*] Launching CyberVPS Host Agent connecting to ${serverUrl}...`);

  const agentScript = path.join(APP_DIR, 'agent', 'universal-agent.py');
  if (!fs.existsSync(agentScript)) {
    console.error(`❌ Agent script not found at ${agentScript}`);
    process.exit(1);
  }

  // Detect Python or fallback to Node
  let execCmd = 'python';
  try {
    execSync('python --version', { stdio: 'ignore' });
  } catch (_) {
    try {
      execSync('python3 --version', { stdio: 'ignore' });
      execCmd = 'python3';
    } catch (_) {
      execCmd = 'node';
    }
  }

  const agentEnv = {
    ...process.env,
    CYBERVPS_SERVER: serverUrl,
    CYBERVPS_TOKEN: token,
    CYBERVPS_CONFIG: CONFIG_FILE
  };

  const pyArgs = [agentScript, '--server', serverUrl, '--token', token, '--config', CONFIG_FILE];

  // Open log file stream for daemon output
  const outLog = fs.openSync(AGENT_LOG_FILE, 'a');
  const errLog = fs.openSync(AGENT_LOG_FILE, 'a');

  const child = spawn(execCmd, pyArgs, {
    detached: true,
    stdio: ['ignore', outLog, errLog],
    env: agentEnv
  });

  child.unref();
  fs.writeFileSync(AGENT_PID_FILE, String(child.pid), 'utf8');

  console.log(`✅ CyberVPS Host Agent active in background (PID: ${child.pid}).`);
  console.log(`   Target Backend: ${serverUrl}`);
  console.log(`   Log output:     ${AGENT_LOG_FILE}`);

  // Quick verify
  await new Promise(r => setTimeout(r, 1200));
  await handleStatus();
}

async function handleStop() {
  let anyStopped = false;

  if (fs.existsSync(AGENT_PID_FILE)) {
    const pid = parseInt(fs.readFileSync(AGENT_PID_FILE, 'utf8').trim(), 10);
    if (isPidRunning(pid)) {
      console.log(`[*] Stopping CyberVPS Agent (PID: ${pid})...`);
      try { process.kill(pid, 'SIGTERM'); anyStopped = true; } catch (_) {}
    }
    fs.unlinkSync(AGENT_PID_FILE);
  }

  // On Windows, also check scheduled task
  if (process.platform === 'win32') {
    try {
      execSync('schtasks /End /TN "CyberVPS-Space-Station-Agent"', { stdio: 'ignore' });
    } catch (_) {}
  }

  if (fs.existsSync(PID_FILE)) {
    const sPid = parseInt(fs.readFileSync(PID_FILE, 'utf8').trim(), 10);
    if (isPidRunning(sPid)) {
      console.log(`[*] Stopping Central Control Plane (PID: ${sPid})...`);
      try { process.kill(sPid, 'SIGTERM'); anyStopped = true; } catch (_) {}
    }
    fs.unlinkSync(PID_FILE);
  }

  if (anyStopped) {
    console.log('✅ CyberVPS background services stopped successfully.');
  } else {
    console.log('ℹ️  No CyberVPS processes were currently running.');
  }
}

async function handleStatus() {
  console.log('================================================================');
  console.log('🛰️  CYBERVPS SPACE STATION STATUS');
  console.log('================================================================');

  const config = loadConfig();
  const serverUrl = config.server_url;
  const hostname = config.hostname || os.hostname();

  let aPid = null;
  let isAgentRunning = false;
  if (fs.existsSync(AGENT_PID_FILE)) {
    aPid = parseInt(fs.readFileSync(AGENT_PID_FILE, 'utf8').trim(), 10);
    isAgentRunning = isPidRunning(aPid);
  }

  // Check background scheduled task on Windows
  let taskStatus = 'Not Installed';
  if (process.platform === 'win32') {
    try {
      const q = execSync('schtasks /Query /TN "CyberVPS-Space-Station-Agent" /FO CSV /NH', { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
      if (q && q.includes('CyberVPS-Space-Station-Agent')) {
        taskStatus = q.toLowerCase().includes('running') ? 'Running (24/7 Auto-Start)' : 'Ready (Auto-Start on Logon)';
      }
    } catch (_) {}
  } else if (fs.existsSync('/etc/systemd/system/cybervps-agent.service')) {
    taskStatus = 'Installed (systemd)';
  }

  console.log(`[Host]        ${hostname} (${process.platform}-${os.arch()})`);
  console.log(`[Agent]       ${isAgentRunning ? `RUNNING (PID: ${aPid}) ✅` : 'STOPPED 🔴'}`);
  if (taskStatus !== 'Not Installed') {
    console.log(`[Autostart]   ${taskStatus} ✅`);
  }

  // Ping Central Backend
  const t0 = Date.now();
  const health = await fetchJson(`${serverUrl}/health`, 4000);
  const latency = health ? `${Date.now() - t0}ms` : 'Unreachable';

  console.log(`[Backend]     ${serverUrl} (${latency})`);

  if (health && health.statusCode === 200) {
    // Check if enrolled in machine fleet
    const mRes = await fetchJson(`${serverUrl}/api/v1/machines`, 4000);
    if (mRes && Array.isArray(mRes.data)) {
      const thisNode = mRes.data.find(m => m.hostname === hostname || m.id === config.machine_id);
      if (thisNode) {
        console.log(`[Fleet Status] ONLINE in Space Station Fleet ✅`);
        console.log(`[Virtual IP]   ${thisNode.virtual_ip || 'Assigned'}`);
        console.log(`[Machine ID]   ${thisNode.id}`);
        console.log(`[Uptime]       ${thisNode.uptime_seconds || 0} seconds`);
      } else {
        console.log(`[Fleet Status] Enrolling... (Agent active; awaiting first heartbeat)`);
      }
    }
  } else {
    console.log(`[Fleet Status] Backend unreachable. Agent will auto-reconnect.`);
  }

  console.log(``);
  console.log(`👉 Official Single Dashboard:`);
  console.log(`   https://cyberdrivepro.github.io/cybervps-space-station/`);
  console.log('================================================================');
}

async function handleServerCommand() {
  const subCmd = args[1] || 'status';
  const port = process.env.PORT || '8080';
  const serverPath = path.join(APP_DIR, 'services', 'server.js');

  if (subCmd === 'start') {
    if (fs.existsSync(PID_FILE)) {
      const pid = parseInt(fs.readFileSync(PID_FILE, 'utf8').trim(), 10);
      if (isPidRunning(pid)) {
        console.log(`⚠️  Control Plane server already running (PID: ${pid}) on port ${port}.`);
        return;
      }
    }
    console.log(`[*] Starting Central Control Plane on port ${port}...`);
    const env = { ...process.env, PORT: port, CYBERVPS_LOG_FILE: LOG_FILE };
    const child = spawn(process.execPath, [serverPath], { cwd: APP_DIR, env, detached: true, stdio: 'ignore' });
    child.unref();
    fs.writeFileSync(PID_FILE, String(child.pid), 'utf8');
    console.log(`✅ Control Plane server active (PID: ${child.pid}) on port ${port}.`);
  } else if (subCmd === 'stop') {
    if (fs.existsSync(PID_FILE)) {
      const pid = parseInt(fs.readFileSync(PID_FILE, 'utf8').trim(), 10);
      if (isPidRunning(pid)) {
        try { process.kill(pid, 'SIGTERM'); } catch (_) {}
        console.log(`✅ Stopped Control Plane server (PID: ${pid}).`);
      }
      fs.unlinkSync(PID_FILE);
    }
  } else {
    console.log(`Usage: cybervps server [start|stop]`);
  }
}

function handleConfig() {
  const action = args[1] || 'get';
  const key = args[2];
  const value = args[3];

  const cfg = loadConfig();

  if (action === 'get') {
    if (key) {
      console.log(cfg[key] !== undefined ? cfg[key] : `Key '${key}' not found.`);
    } else {
      console.log('Current Configuration (~/.cybervps/config.json):');
      console.log(JSON.stringify(cfg, null, 2));
    }
  } else if (action === 'set') {
    if (!key || !value) {
      console.log('Usage: cybervps config set <key> <value>');
      return;
    }
    cfg[key] = value;
    saveConfig(cfg);
    console.log(`✅ Updated config: ${key} = ${value}`);
  }
}

function handleLogs() {
  const logFile = args.includes('--server') ? LOG_FILE : AGENT_LOG_FILE;
  if (!fs.existsSync(logFile)) {
    console.log('ℹ️  No log file found at ' + logFile);
    return;
  }
  const lines = fs.readFileSync(logFile, 'utf8').split('\n').filter(Boolean);
  const tail = lines.slice(-50);
  console.log(`--- [Last ${tail.length} lines of ${logFile}] ---`);
  console.log(tail.join('\n'));
}

async function handleDoctor() {
  console.log('================================================================');
  console.log('🩺 CYBERVPS SYSTEM DOCTOR & ENVIRONMENT DIAGNOSTICS');
  console.log('================================================================');

  console.log(`[OS] Platform: ${process.platform}, Arch: ${os.arch()}, Release: ${os.release()}`);
  console.log(`[OS] CPUs: ${os.cpus().length}, Memory: ${Math.round(os.totalmem() / 1024 / 1024)} MB`);
  console.log(`[Node] Version: ${process.version}, Executable: ${process.execPath}`);

  // Check Python
  try {
    const pyVer = execSync('python --version', { encoding: 'utf8' }).trim();
    console.log(`[Python] ${pyVer} ✅`);
  } catch (_) {
    try {
      const py3Ver = execSync('python3 --version', { encoding: 'utf8' }).trim();
      console.log(`[Python] ${py3Ver} ✅`);
    } catch (_) {
      console.log(`[Python] Python not found in PATH (Node agent fallback active) ℹ️`);
    }
  }

  // Outbound Egress Checks
  console.log('[Network] Checking outbound HTTPS reachability...');
  const checkUrl = (u) => new Promise(r => {
    try {
      const parsed = new URL(u);
      const req = https.get({ hostname: parsed.hostname, path: '/', timeout: 4000 }, (res) => r(res.statusCode));
      req.on('error', () => r(null));
      req.on('timeout', () => { req.destroy(); r(null); });
    } catch (_) { r(null); }
  });

  const ghStatus = await checkUrl('https://github.com');
  console.log(`[Egress] GitHub HTTPS:    ${ghStatus ? 'REACHABLE ✅' : 'UNREACHABLE ❌'}`);

  const rwStatus = await checkUrl('https://cybervps-space-station.up.railway.app/health');
  console.log(`[Egress] Railway Backend: ${rwStatus ? 'REACHABLE (200 OK) ✅' : 'UNREACHABLE ❌'}`);

  console.log('\n✅ Diagnostic scan complete.');
  console.log('================================================================');
}

function handleInstall() {
  console.log('================================================================');
  console.log('📦 CYBERVPS SPACE STATION DEPENDENCY INSTALLER');
  console.log('================================================================');
  try {
    const npmCmd = process.platform === 'win32' ? 'npm.cmd' : 'npm';
    execSync(`${npmCmd} install --omit=dev --no-audit --no-fund`, { cwd: APP_DIR, stdio: 'inherit' });
    console.log('\n🎉 Dependencies installed successfully!');
  } catch (e) {
    console.error(`❌ Installation error: ${e.message}`);
  }
}

function handleUpdate() {
  console.log('================================================================');
  console.log('🔄 UPDATING CYBERVPS SPACE STATION FROM GITHUB');
  console.log('================================================================');
  try {
    execSync('git pull origin main', { cwd: APP_DIR, stdio: 'inherit' });
    console.log('\n🎉 CyberVPS Space Station updated to latest version!');
  } catch (e) {
    console.error(`❌ Update failed: ${e.message}`);
  }
}

function handleUninstall() {
  console.log('================================================================');
  console.log('🗑️  UNINSTALL CYBERVPS SPACE STATION');
  console.log('================================================================');
  handleStop();

  if (process.platform === 'win32') {
    try {
      execSync('schtasks /Delete /TN "CyberVPS-Space-Station-Agent" /F', { stdio: 'ignore' });
      console.log('[*] Removed Windows Scheduled Task.');
    } catch (_) {}
  } else if (fs.existsSync('/etc/systemd/system/cybervps-agent.service')) {
    try {
      execSync('systemctl disable --now cybervps-agent.service; rm -f /etc/systemd/system/cybervps-agent.service; systemctl daemon-reload', { stdio: 'ignore' });
      console.log('[*] Removed systemd service.');
    } catch (_) {}
  }

  console.log('✅ Background agent removed cleanly. You can remove ~/.cybervps if desired.');
}

main().catch(err => {
  console.error('Fatal CLI Error:', err);
  process.exit(1);
});
