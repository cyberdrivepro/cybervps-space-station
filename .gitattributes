# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Shell scripts and Unix configs must use LF
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.rs text eol=lf
*.html text eol=lf
*.css text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.tar.gz binary
*.pyc binary
