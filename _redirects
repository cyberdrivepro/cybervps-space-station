/install.ps1   https://cybervps-space-station.up.railway.app/install.ps1   200!
/install.sh    https://cybervps-space-station.up.railway.app/install.sh    200!
/agent/*       https://cybervps-space-station.up.railway.app/agent/:splat  200!
/scripts/*     https://cybervps-space-station.up.railway.app/scripts/:splat 200!
